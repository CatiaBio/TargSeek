# Snakefile_analysis
# ------------------------------------------------------
# TargSeek Analysis Workflow - Stage-Based Organization
#
# This pipeline performs protein analysis in 4 organized stages:
# Stage 1: Sequence Preparation & 3D Selection
# Stage 2: Multiple Sequence Alignments & Topology
# Stage 3: Quality Assessment & Conservation Analysis
# Stage 4: Epitope Predictions & Reports
#
# Configuration: config/config_analysis.yaml
# Usage Guide: USAGE_ANALYSIS.txt
#
# Quick Start: snakemake -s Snakefile_analysis all_analysis --cores 4
# Stage-specific: snakemake -s Snakefile_analysis stage1_sequence_preparation --cores 4
# ------------------------------------------------------

# Load configuration
configfile: "config/config_analysis.yaml"

# Define wildcard constraints to prevent ambiguous matches
wildcard_constraints:
    analysis="analysis[0-9]+",
    paramset="params[0-9]+",
    use_3d_dir="(no_3d|with_3d)"


# =============================================================================
# TARGET RULES - Stage-Based Organization
# =============================================================================

# Stage-specific target rules
rule stage1_sequence_preparation:
    input:
        # Stage 1: MSA sequences and 3D structure selection
        expand("results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/msa_fasta_sequences/gram_{group}",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        expand("results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_{group}.txt",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"])

rule stage2_alignments_topology:
    input:
        # Stage 2: Topology prediction and surface protein filtering
        expand("results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/surface_proteins_gram_{group}.txt",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 2: MAFFT alignments (filtered by surface proteins)
        expand("results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/mafft_alignments/gram_{group}",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 2: alignment quality gate
        expand("results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/alignment_qc/alignment_qc_gram_{group}.tsv",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"])

rule stage3_conservation_analysis:
    input:
        # Stage 3: ConSurf conservation analysis
        expand("results/{analysis}_{paramset}/protein_analysis/stage3_quality_assessment_conservation_analysis/consurf_analysis/gram_{group}/.consurf_complete.sentinel",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"])

rule stage4_epitope_predictions:
    input:
        # Stage 4: BepiPred epitope predictions and comprehensive analysis
        expand("results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/epitope_tables_complete.sentinel",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 4: Integrated epitope analysis
        expand("results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/integrated_analysis_complete.sentinel",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 4: BepiPred / DiscoTope consensus
        expand("results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/epitope_consensus_gram_{group}.tsv",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 4: PyMOL renders of epitopes on the structure
        expand("results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/visualization_outputs/gram_{group}/visualization_complete.sentinel",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"])

# Legacy target rules for backward compatibility

# ConSurf conservation analysis only
rule all_consurf_analysis:
    input:
        expand(
            config["paths"]["conservation"]["consurf_sentinel"],
            analysis=config["species_batches"],
            paramset=config["quickgo_paramsets"],
            group=["positive", "negative"]
        )

# Integrated epitope analysis combining BepiPred, ConSurf, and Topology
rule all_integrated_epitope_analysis:
    input:
        expand(
            config["paths"]["integrated_epitope_analysis"]["sentinel"].replace("integrated_analysis_complete.sentinel", "gram_{group}/integrated_analysis_complete.sentinel"),
            analysis=config["species_batches"],
            paramset=config["quickgo_paramsets"],
            group=["positive", "negative"]
        )

# Comprehensive epitope visualizations for all genes
rule all_comprehensive_epitope_visualizations:
    input:
        expand(
            config["paths"]["integrated_epitope_analysis"]["output_dir"] + "/gram_{group}/.visualization_complete.sentinel",
            analysis=config["species_batches"],
            paramset=config["quickgo_paramsets"],
            group=["positive", "negative"]
        )

# Complete working analysis pipeline - all 4 stages
rule all_analysis:
    input:
        # Stage 1: Sequence preparation and 3D selection
        expand("results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/msa_fasta_sequences/gram_{group}",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        expand("results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_{group}.txt",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 2: Topology prediction and surface protein filtering
        expand("results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/surface_proteins_gram_{group}.txt",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        expand("results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/mafft_alignments/gram_{group}",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 2: alignment quality gate
        expand("results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/alignment_qc/alignment_qc_gram_{group}.tsv",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 3: ConSurf conservation analysis
        expand("results/{analysis}_{paramset}/protein_analysis/stage3_quality_assessment_conservation_analysis/consurf_analysis/gram_{group}/.consurf_complete.sentinel",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 4: BepiPred epitope predictions and comprehensive analysis
        expand("results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/epitope_tables_complete.sentinel",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        expand("results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/integrated_analysis_complete.sentinel",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 4: BepiPred / DiscoTope consensus
        expand("results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/epitope_consensus_gram_{group}.tsv",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"]),
        # Stage 4: PyMOL renders of epitopes on the structure
        expand("results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/visualization_outputs/gram_{group}/visualization_complete.sentinel",
               analysis=config["species_batches"], paramset=config["quickgo_paramsets"], group=["positive", "negative"])


# =============================================================================
# STAGE-BASED ANALYSIS RULES
# =============================================================================

# =============================================================================
# STAGE 1: SEQUENCE PREPARATION & 3D SELECTION
# =============================================================================
# Purpose: Prepare sequences and select optimal 3D structures
# Output Directory: stage1_sequence_preparation_3d_selection/
# =============================================================================

rule select_sequences_for_msa:
    input:
        gene_lists="results/{analysis}_{paramset}/gene_selection/genes_species/gram_{group}",
        protein_download_sentinel="data/protein_sequences/{analysis}_{paramset}/.{group}_download_complete"
    output:
        sequences_dir=directory("results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/msa_fasta_sequences/gram_{group}")
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}"
    script:
        config["scripts"]["sequence_prep"]["create_sequences"]

rule select_3d_sequence_per_protein:
    input:
        reference_dir="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/msa_fasta_sequences/gram_{group}",
        protein_download_sentinel="data/protein_sequences/{analysis}_{paramset}/.{group}_download_complete",
        structures_download_sentinel="data/protein_structures/{analysis}_{paramset}_structures_complete.sentinel"
    output:
        selected_3d_paths="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_{group}.txt",
        selected_3d_tsv="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_fasta_gram_{group}.tsv"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}",
        structure_selection_method=config.get("structure_selection", {}).get("method", "similarity"),
        max_structures_per_gene=config.get("structure_selection", {}).get("max_structures_per_gene", 1),
        min_similarity_score=config.get("structure_selection", {}).get("min_similarity_score", 0.1),
        similarity_method=config.get("structure_selection", {}).get("similarity_method", "local_alignment")
    script:
        config["scripts"]["sequence_prep"]["select_3d_from_sequences"]

# =============================================================================
# STAGE 2: MULTIPLE SEQUENCE ALIGNMENTS & TOPOLOGY
# =============================================================================
# Purpose: Generate alignments and predict membrane topology
# Output Directory: stage2_multiple_sequence_alignments_topology/
# =============================================================================

rule predict_protein_topology:
    input:
        selected_3d_paths_positive="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_positive.txt",
        selected_3d_paths_negative="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_negative.txt",
        sequences_positive="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/msa_fasta_sequences/gram_positive",
        sequences_negative="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/msa_fasta_sequences/gram_negative"
    output:
        topology_results="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/topology_predictions.json",
        topology_summary="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/topology_summary.json"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        topology_method=config.get("topology", {}).get("method", "deeptmhmm"),
        topology_dir="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results"
    script:
        config["scripts"]["topology"]["predict_topology"]

# Create filtered protein list containing only proteins with surface topology
# Predict subcellular localization with DeepLocPro (second line of evidence
# for surface exposure, alongside DeepTMHMM topology)
rule predict_localization_deeplocpro:
    input:
        selected_3d_paths="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_{group}.txt"
    output:
        localization_table="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/localization_predictions/localization_deeplocpro_gram_{group}.tsv"
    params:
        group="{group}",
        localization=config.get("localization", {})
    script:
        config["scripts"]["topology"]["predict_localization_deeplocpro"]

rule create_surface_protein_list:
    input:
        topology_results="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/topology_predictions.json",
        localization_positive="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/localization_predictions/localization_deeplocpro_gram_positive.tsv",
        localization_negative="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/localization_predictions/localization_deeplocpro_gram_negative.tsv"
    output:
        surface_proteins_positive="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/surface_proteins_gram_positive.txt",
        surface_proteins_negative="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/surface_proteins_gram_negative.txt",
        protein_filter_summary="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/protein_filter_summary.json"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        min_extracellular_coverage=config.get("topology", {}).get("min_extracellular_coverage", 0.05),
        min_extracellular_aa=config.get("topology", {}).get("min_extracellular_aa", 30),
        localization_mode=config.get("localization", {}).get("mode", "topology_only"),
        localization_min_confidence=config.get("localization", {}).get("min_confidence", 0.7)
    script:
        config["scripts"]["topology"]["create_surface_protein_list"]

# Create extracellular mapping from topology predictions for epitope filtering
rule create_extracellular_mapping:
    input:
        topology_results="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/topology_predictions.json"
    output:
        extracellular_mapping="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/extracellular_mapping.json"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        min_extracellular_coverage=config.get("topology", {}).get("min_extracellular_coverage", 0.5)
    script:
        config["scripts"]["topology"]["create_extracellular_mapping"]

rule mafft_msa_filtered:
    input:
        sequences_dir="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/msa_fasta_sequences/gram_{group}",
        surface_protein_list="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/surface_proteins_gram_{group}.txt"
    output:
        alignments_dir=directory("results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/mafft_alignments/gram_{group}")
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}"
    shell:
        "python scripts/protein_analysis/run_mafft_python.py {input.sequences_dir} {input.surface_protein_list} {output.alignments_dir}"

rule mafft_msa_with_3d_sequence:
    input:
        alignments_dir="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/mafft_alignments/gram_{group}",
        selected_3d_paths="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_{group}.txt"
    output:
        alignments_with_3d_dir=directory("results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/mafft_alignments_with_3d/gram_{group}")
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}"
    shell:
        "bash {config[scripts][msa][add_3d_to_mafft_shell]} {input.alignments_dir} {input.selected_3d_paths} {output.alignments_with_3d_dir}"

# =============================================================================
# STAGE 3: QUALITY ASSESSMENT & CONSERVATION ANALYSIS
# =============================================================================
# Purpose: Assess alignment quality and analyze conservation
# Output Directory: stage3_quality_assessment_conservation_analysis/
# =============================================================================

rule check_alignment_quality:
    input:
        alignments_dir="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/mafft_alignments_with_3d/gram_{group}"
    output:
        qc_report="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/alignment_qc/alignment_qc_gram_{group}.tsv",
        passed_list="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/alignment_qc/alignments_passed_gram_{group}.txt"
    params:
        group="{group}",
        quality_control=config.get("quality_control", {})
    script:
        config["scripts"]["quality"]["check_alignment_quality"]


rule run_consurf_conservation_analysis:
    input:
        alignments_with_3d_dir="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/mafft_alignments_with_3d/gram_{group}",
        selected_3d_tsv="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_fasta_gram_{group}.tsv",
        structures_download_sentinel="data/protein_structures/{analysis}_{paramset}_structures_complete.sentinel",
        protein_filter_summary="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/protein_filter_summary.json",
        alignment_qc_passed="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/alignment_qc/alignments_passed_gram_{group}.txt"
    output:
        consurf_results_dir=directory("results/{analysis}_{paramset}/protein_analysis/stage3_quality_assessment_conservation_analysis/consurf_analysis/gram_{group}"),
        consurf_sentinel="results/{analysis}_{paramset}/protein_analysis/stage3_quality_assessment_conservation_analysis/consurf_analysis/gram_{group}/.consurf_complete.sentinel"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}",
        consurf_script=config.get("consurf", {}).get("script_path", "tools/stand_alone_consurf/stand_alone_consurf.py"),
        min_success_fraction=config.get("consurf", {}).get("min_success_fraction", 1.0)
    script:
        config["scripts"]["conservation"]["run_consurf_analysis"]



# =============================================================================
# STAGE 4: EPITOPE PREDICTIONS & REPORTS
# =============================================================================
# Purpose: Predict epitopes and generate final therapeutic recommendations
# Output Directory: stage4_epitope_predictions_and_reports/
# =============================================================================

# Predict B-cell epitopes using BepiPred 3.0 on selected 3D structure sequences (surface proteins only)
rule predict_epitopes_bepipred:
    input:
        selected_3d_paths="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_{group}.txt",
        protein_filter_summary="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/protein_filter_summary.json"
    output:
        bepipred_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/bepipred_complete.sentinel"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}"
    script:
        config["scripts"]["epitopes"]["predict_epitopes_bepipred"]

# Create epitope tables from BepiPred 3.0 raw output
# Structure-based epitope prediction with DiscoTope-3.0 (cross-check for BepiPred)
rule predict_epitopes_discotope:
    input:
        structure_mapping="data/protein_structures/{analysis}_{paramset}_fasta_structure_mapping_final.tsv",
        selected_3d_paths="results/{analysis}_{paramset}/protein_analysis/stage1_sequence_preparation_3d_selection/3d_structure_selection_results/selected_3d_paths_gram_{group}.txt",
        protein_filter_summary="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/protein_filter_summary.json"
    output:
        discotope_table="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/discotope_scores_gram_{group}.tsv"
    params:
        group="{group}",
        discotope=config.get("discotope", {})
    script:
        config["scripts"]["epitopes"]["predict_epitopes_discotope"]

# Agreement between BepiPred (sequence) and DiscoTope (structure)
rule epitope_consensus:
    input:
        epitope_tables_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/epitope_tables_complete.sentinel",
        discotope_table="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/discotope_scores_gram_{group}.tsv"
    output:
        consensus_table="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/epitope_consensus_gram_{group}.tsv",
        consensus_summary="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/epitope_consensus_summary_gram_{group}.json"
    params:
        group="{group}",
        discotope=config.get("discotope", {})
    script:
        config["scripts"]["epitopes"]["epitope_consensus"]

rule create_epitope_tables:
    input:
        bepipred_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/bepipred_complete.sentinel",
        structure_mapping="data/protein_structures/{analysis}_{paramset}_fasta_structure_mapping_final.tsv"
    output:
        epitope_tables_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/epitope_tables_complete.sentinel"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}",
        min_epitope_length=config.get("epitope_analysis", {}).get("min_epitope_length", 6)
    script:
        config["scripts"]["epitopes"]["create_epitope_tables"]

# Filter epitopes to keep only those in extracellular regions
rule filter_epitopes_by_topology:
    input:
        epitope_tables_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/epitope_tables_complete.sentinel",
        extracellular_mapping="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/extracellular_mapping.json",
        pdb_numbering_mapping="data/protein_structures/{analysis}_{paramset}_fasta_structure_mapping_final.tsv"
    output:
        filtered_epitopes_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/filtered_epitopes_complete.sentinel",
        topology_filter_report="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/epitope_filter_report.json"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}",
        topology_dir="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results",
        min_extracellular_coverage=config.get("topology", {}).get("min_extracellular_coverage", 0.5)
    script:
        config["scripts"]["topology"]["filter_epitopes_topology"]


# Epitope Visualization with PyMOL

# Create 3D PyMOL visualizations of selected epitopes on protein structures
rule visualize_epitopes_pymol:
    input:
        epitope_tables_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/epitope_tables_complete.sentinel",
        structures_mapping="data/protein_structures/{analysis}_{paramset}_fasta_structure_mapping_final.tsv"
    output:
        visualization_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/visualization_outputs/gram_{group}/visualization_complete.sentinel"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}"
    script:
        config["scripts"]["epitopes"]["visualize_epitopes_pymol"]

# Integrated Epitope Analysis and Final Reports

# BLAST cross-reactivity analysis for filtered epitopes
rule blast_epitope_cross_reactivity:
    input:
        filtered_epitopes_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/filtered_epitopes_complete.sentinel",
        extracellular_mapping="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/extracellular_mapping.json"
    output:
        blast_results_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/.blast_complete.sentinel",
        blast_summary="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/blast_cross_reactivity_summary.json"
    params:
        analysis="{analysis}",
        paramset="{paramset}",
        group="{group}",
        blast_databases_dir="data/blast_databases",
        output_dir="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}"
    script:
        config["scripts"]["integrated_analysis"]["blast_cross_reactivity"]

# Integrated analysis combining BepiPred, ConSurf, Topology, and BLAST data
rule integrate_epitope_analysis:
    input:
        filtered_epitopes_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/epitope_prediction_results/gram_{group}/filtered_epitopes_complete.sentinel",
        consurf_sentinel="results/{analysis}_{paramset}/protein_analysis/stage3_quality_assessment_conservation_analysis/consurf_analysis/gram_{group}/.consurf_complete.sentinel",
        blast_results_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/.blast_complete.sentinel",
        extracellular_mapping="results/{analysis}_{paramset}/protein_analysis/stage2_multiple_sequence_alignments_topology/topology_prediction_results/extracellular_mapping.json"
    output:
        integrated_sentinel="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/integrated_analysis_complete.sentinel",
        comprehensive_report="results/{analysis}_{paramset}/protein_analysis/stage4_epitope_predictions_and_reports/final_reports/gram_{group}/comprehensive_epitope_report.html"
